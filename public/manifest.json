{
  "manifest_version": 3,
  "name": "Privacy Guard",
  "version": "1.0.0",
  "description": "Monitor network privacy, detect potential leaks, and manage browser privacy settings.",
  "permissions": [
    "storage",
    "alarms",
    "privacy",
    "activeTab",
    "scripting",
    "contentSettings"
  ],
  "host_permissions": [
    "https://api.ipify.org/*",
    "https://ipapi.co/*",
    "https://dnsleak.dev/*",
    "https://*.t.dnsleak.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Privacy Guard"
  }
}
