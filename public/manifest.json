
{
  "manifest_version": 3,
  "name": "Privacy Guard",
  "version": "1.0.0",
  "description": "Monitor network privacy, detect potential leaks, and manage browser privacy settings.",
"permissions": [
  "storage",
  "alarms",
  "privacy"
],
  "host_permissions": [
    "https://ipwho.is/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Privacy Guard"
  }
}
